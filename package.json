{
  "name": "@ningtian-byte/dsh-context-manager",
  "version": "0.1.2",
  "description": "Selectively compact, exclude and import conversation context in DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingTiAn-byte/DSH-context-manager.git"
  },
  "homepage": "https://github.com/NingTiAn-byte/DSH-context-manager#readme",
  "bugs": {
    "url": "https://github.com/NingTiAn-byte/DSH-context-manager/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "context.js",
    "imports.js",
    "errors.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/context-manager.png",
    "docs/cross-session-import.png",
    "docs/find-context.png",
    "docs/cross-session-import.md",
    "docs/implementation.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check context.js && node --check imports.js && node --check errors.js && node --check client.js",
    "test": "node --test tests/*.test.js",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
